# =============================================================================
# Django Settings
# =============================================================================

# Enable debug mode (set to 0 in production)
DEBUG=1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here

# Comma-separated list of allowed hostnames (use * for development)
DJANGO_ALLOWED_HOSTS=*

# =============================================================================
# PostgreSQL Database
# =============================================================================

# Database driver selector — keep as "postgres" to use PostgreSQL
DATABASE_URL=postgres

# Database name
POSTGRES_DB=sitechime

# Database user
POSTGRES_USER=sitechime

# Database user password
POSTGRES_PASSWORD=your-secure-password

# Hostname — localhost for host networking, container name for bridge networking
POSTGRES_HOST=localhost

# Port (default: 5432)
POSTGRES_PORT=5432

# Postgres superuser password (used by the db container to initialize)
# Only needed when running the db service in docker-compose
POSTGRES_SUPER_PASSWORD=

# =============================================================================
# Django Superuser (auto-created on container start via entrypoint.sh)
# =============================================================================

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-secure-admin-password

# =============================================================================
# OpenAI Proxy
# =============================================================================

# Upstream OpenAI-compatible API base URL (no trailing slash)
OPENAI_PROXY_URL=http://localhost:8080

# API token for authenticating with the upstream proxy
OPENWEBUI_API_TOKEN=your-api-token-here

# =============================================================================
# Redis (used for caching and rate limiting)
# =============================================================================

# Hostname — localhost for host networking, container name for bridge networking
REDIS_HOST=localhost

# Port (default: 6379)
REDIS_PORT=6379

# Leave empty if Redis has no password
REDIS_PASSWORD=
